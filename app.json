{
  "expo": {
    "name": "iziClub",
    "slug": "iziClub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icone_app_store_1024_claire.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": false,
      "bundleIdentifier": "fr.iziclub.mobile"
    },
    "android": {
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#EDF2F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gaut_er.iziClub"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "iziClub utilise ta position pour trouver des clubs et des événements près de toi."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "iziClub utilise l'appareil photo pour prendre en photo un justificatif à joindre à ton dossier.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "iziClub ajoute à ton calendrier les événements que tu choisis.",
          "remindersPermission": "iziClub n'utilise pas tes rappels."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#EDF2F4"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ccdb0353-ccbd-4855-a5b3-66ff589fee5d"
      }
    }
  }
}
